{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "{{APP_VERSION}}",
  "id": "{{MICROSOFT_APP_ID}}",
  "developer": {
    "name": "Sunstone Engineering LLC",
    "websiteUrl": "{{APP_BASE_URL}}",
    "privacyUrl": "{{APP_BASE_URL}}/privacy",
    "termsOfUseUrl": "{{APP_BASE_URL}}/terms"
  },
  "name": {
    "short": "UTM Builder",
    "full": "Sunstone UTM Builder"
  },
  "description": {
    "short": "Create standardized Sunstone UTM links.",
    "full": "Internal Sunstone tool for creating standardized UTM links across marketing, ecommerce, sales, support, events, marketplaces, QR codes, and agentic search references."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "FF8200",
  "staticTabs": [
    {
      "entityId": "utm-builder",
      "name": "UTM Builder",
      "contentUrl": "{{APP_BASE_URL}}?teams_user_email={user.userPrincipalName}&teams_login_hint={user.loginHint}&teams_user_id={user.id}&teams_tenant_id={user.tenant.id}&teams_display_name={user.displayName}",
      "websiteUrl": "{{APP_BASE_URL}}",
      "scopes": ["personal"]
    }
  ],
  "validDomains": [
    "{{APP_DOMAIN}}"
  ]
}
